---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import chimmiMakis from "../../../assets/menu-img/Chimmi Makis.jpg";
import migiriSushi from "../../../assets/menu-img/Migiri Sushi.jpg";
import togarashiMakis from "../../../assets/menu-img/Togarashi Makis.jpg";
import salmonRoll from "../../../assets/menu-img/Salmon Roll.jpg";
import macarons from "../../../assets/menu-img/macrons.jpeg";

const items = [
  { name: "Chimmi Makis", image: chimmiMakis, price: 17500, originalPrice: 22000 },
  { name: "Migiri Sushi", image: migiriSushi, price: 26000, originalPrice: 32000 },
  { name: "Togarashi Makis", image: togarashiMakis, price: 15000, originalPrice: 20000 },
  { name: "Salmon Roll", image: salmonRoll, price: 26000, originalPrice: 32000 },
  { name: "Macarons", image: macarons, price: 16000, originalPrice: 20000 },
].map((item) => ({
  ...item,
  discount: Math.round((1 - item.price / item.originalPrice) * 100),
}));

const formatMMK = (value: number) => `${value.toLocaleString("en-US")} MMK`;
---

<section class="bg-cream">
  <div class="mx-auto max-w-7xl px-6 py-24 lg:px-10">
    <div class="flex flex-wrap items-end justify-between gap-6">
      <div>
        <div class="flex items-center gap-3 text-primary">
          <span class="h-px w-10 bg-primary"></span>
          <span class="text-sm font-medium tracking-[0.2em]">プロモーション</span>
        </div>
        <h2 class="font-display mt-4 text-4xl font-medium text-ink lg:text-5xl">
          Christmas Promotions
        </h2>
      </div>
      <a
        href="#menu"
        class="inline-flex items-center gap-2 rounded-full bg-primary px-7 py-3.5 text-sm font-semibold text-white transition-colors hover:bg-primary-dark"
      >
        See All
      </a>
    </div>

    <div class="relative mt-12">
      <div
        id="promo-track"
        class="grid auto-cols-[75%] grid-flow-col gap-5 overflow-x-auto scroll-smooth pb-2 [scrollbar-width:none] snap-x snap-mandatory sm:auto-cols-[45%] lg:auto-cols-[23%] [&::-webkit-scrollbar]:hidden"
      >
        {
          items.map((item) => (
            <article class="snap-start overflow-hidden rounded-2xl bg-white shadow-sm ring-1 ring-ink/5">
              <div class="relative aspect-square">
                <Image
                  src={item.image}
                  alt={item.name}
                  width={500}
                  height={500}
                  class="h-full w-full object-cover"
                />
                {item.discount > 0 && (
                  <span class="absolute left-3 top-3 rounded-full bg-primary px-2.5 py-1 text-xs font-semibold text-white">
                    {item.discount}%
                  </span>
                )}
              </div>
              <div class="p-5">
                <h3 class="font-display text-lg font-medium text-ink">
                  {item.name}
                </h3>
                <p class="mt-1.5 flex items-baseline gap-2">
                  <span class="text-sm font-semibold text-primary">
                    {formatMMK(item.price)}
                  </span>
                  {item.discount > 0 && (
                    <span class="text-xs text-muted line-through">
                      {formatMMK(item.originalPrice)}
                    </span>
                  )}
                </p>
              </div>
            </article>
          ))
        }
      </div>

      <div class="mt-8 flex items-center justify-center gap-4">
        <button
          id="promo-prev"
          type="button"
          aria-label="Previous promotions"
          class="flex h-11 w-11 items-center justify-center rounded-full border border-ink/15 text-ink transition-colors hover:border-primary hover:text-primary"
        >
          <Icon name="ph:caret-left" class="h-5 w-5" />
        </button>
        <span
          id="promo-counter"
          class="flex h-11 w-11 items-center justify-center rounded-full bg-primary text-sm font-semibold text-white"
        >
          1
        </span>
        <button
          id="promo-next"
          type="button"
          aria-label="Next promotions"
          class="flex h-11 w-11 items-center justify-center rounded-full border border-ink/15 text-ink transition-colors hover:border-primary hover:text-primary"
        >
          <Icon name="ph:caret-right" class="h-5 w-5" />
        </button>
      </div>
    </div>
  </div>
</section>

<script>
  const track = document.getElementById("promo-track");
  const counter = document.getElementById("promo-counter");
  const prevBtn = document.getElementById("promo-prev");
  const nextBtn = document.getElementById("promo-next");

  if (track && counter && prevBtn && nextBtn) {
    const getCardWidth = () =>
      track.firstElementChild instanceof HTMLElement
        ? track.firstElementChild.getBoundingClientRect().width + 20
        : track.clientWidth;

    const updateCounter = () => {
      const index = Math.round(track.scrollLeft / getCardWidth()) + 1;
      counter.textContent = String(Math.min(index, track.children.length));
    };

    prevBtn.addEventListener("click", () => {
      track.scrollBy({ left: -getCardWidth(), behavior: "smooth" });
    });

    nextBtn.addEventListener("click", () => {
      track.scrollBy({ left: getCardWidth(), behavior: "smooth" });
    });

    track.addEventListener("scroll", () => {
      window.requestAnimationFrame(updateCounter);
    });
  }
</script>
