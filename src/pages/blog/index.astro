---
import Layout from "../../layouts/Layout.astro";
import PageHero from "../../components/PageHero.astro";
import Pagination from "../../components/Pagination.astro";
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import { blogPosts } from "../../data/blog";
import heroImg from "../../assets/home-img/heroImg.png";
---

<Layout
  title="Blog - Myanshi"
  description="Sushi-making tips, kitchen guides, and stories from the MYANSHI team."
>
  <main>
    <PageHero title="Our Blog" crumbs={[{ label: "Blog" }]} image={heroImg} />

    <section class="bg-cream">
      <div class="mx-auto max-w-5xl px-6 py-24 lg:px-10">
        <div class="space-y-16">
          {
            blogPosts.map((post) => (
              <article
                class="flex flex-col gap-8 lg:flex-row lg:items-center lg:gap-14"
                data-reveal
              >
                <div class="flex-1">
                  <div class="flex items-center gap-3 text-sm text-muted">
                    <span class="font-medium text-ink">{post.author}</span>
                    <span class="h-px w-6 bg-ink/20" />
                    <span>{post.date}</span>
                  </div>
                  <h2 class="font-display mt-3 text-2xl font-medium text-ink sm:text-3xl">
                    {post.title}
                  </h2>
                  <p class="mt-4 max-w-lg text-sm leading-relaxed text-muted">
                    {post.excerpt}
                  </p>
                  <a
                    href={`/blog/${post.slug}`}
                    class="mt-5 inline-flex items-center gap-2 text-sm font-semibold text-primary hover:text-primary-dark"
                  >
                    Read More
                    <Icon name="ph:arrow-right" class="h-4 w-4" />
                  </a>
                </div>
                <a
                  href={`/blog/${post.slug}`}
                  class="block w-full overflow-hidden rounded-2xl lg:w-96 lg:shrink-0"
                >
                  <Image
                    src={post.image}
                    alt={post.title}
                    width={640}
                    height={480}
                    class="h-64 w-full object-cover transition-transform duration-300 hover:scale-105"
                  />
                </a>
              </article>
            ))
          }
        </div>

        <Pagination currentPage={1} totalPages={1} basePath="/blog" />
      </div>
    </section>
  </main>
</Layout>
