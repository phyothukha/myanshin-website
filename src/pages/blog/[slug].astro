---
import Layout from "../../layouts/Layout.astro";
import PageHero from "../../components/PageHero.astro";
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import { blogPosts } from "../../data/blog";

export function getStaticPaths() {
  return blogPosts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
---

<Layout title={`${post.title} - Myanshi Blog`} description={post.excerpt}>
  <main>
    <PageHero title={post.title} crumb={post.title} image={post.image} />

    <article class="bg-cream">
      <div class="mx-auto max-w-3xl px-6 py-20 lg:px-10">
        <div class="flex items-center gap-3 text-sm text-muted">
          <Image
            src={post.avatar}
            alt={post.author}
            width={36}
            height={36}
            class="h-9 w-9 rounded-full object-cover"
          />
          <span class="font-medium text-ink">{post.author}</span>
          <span class="h-px w-6 bg-ink/20"></span>
          <span>{post.date}</span>
        </div>

        <div class="mt-8 space-y-5">
          {
            post.body.map((paragraph) => (
              <p class="text-base leading-relaxed text-ink/80">{paragraph}</p>
            ))
          }
        </div>

        <a
          href="/blog"
          class="mt-12 inline-flex items-center gap-2 text-sm font-semibold text-primary hover:text-primary-dark"
        >
          <Icon name="ph:arrow-left" class="h-4 w-4" />
          Back to Blog
        </a>
      </div>
    </article>
  </main>
</Layout>
