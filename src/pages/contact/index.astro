---
import Layout from "../../layouts/Layout.astro";
import PageHero from "../../components/PageHero.astro";
import VisitRestaurants from "../../components/VisitRestaurants.astro";
import TiktokGallery from "../../components/TiktokGallery.astro";
import BookingForm from "./_sections/BookingForm.astro";
import Faq from "./_sections/Faq.astro";
import heroImg from "../../assets/home-img/adsImg.png";
---

<Layout
  title="Contact Us - Myanshi"
  description="Book a table at any MYANSHI branch, find answers to common questions, or get in touch with our team."
>
  <main id="main-content">
    <PageHero
      title="Contact Us"
      crumbs={[{ label: "Contact" }]}
      image={heroImg}
    >
      <BookingForm />
    </PageHero>
    <VisitRestaurants />
    <Faq />
    <TiktokGallery />
  </main>
</Layout>
