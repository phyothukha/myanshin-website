---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import chimmiMakis from "../../../assets/menu-img/Chimmi Makis.jpg";
import migiriSushi from "../../../assets/menu-img/Migiri Sushi.jpg";
import togarashiMakis from "../../../assets/menu-img/Togarashi Makis.jpg";
import salmonRoll from "../../../assets/menu-img/Salmon Roll.jpg";
import macarons from "../../../assets/menu-img/macrons.jpeg";
import dorayaki from "../../../assets/menu-img/dorayaki.jpeg";
import tofuPancake from "../../../assets/menu-img/tofuPancake.jpeg";
import honeyCookies from "../../../assets/menu-img/honeyCookies.jpg";
import coffee from "../../../assets/menu-img/coffee.jpeg";
import matchaTea from "../../../assets/menu-img/Matcha_Tea.jpg";
import amazake from "../../../assets/menu-img/Amazake.jpg";
import sake from "../../../assets/menu-img/sake.png";
import tunaPokeBowl from "../../../assets/menu-img/Tuna Poke Bowl.jpg";
import sardineStew from "../../../assets/menu-img/Sardine Stew.jpg";
import vegetarianRamen from "../../../assets/menu-img/Vegetarian Ramen.jpg";
import vegetarianSoup from "../../../assets/menu-img/Vegetarian Soup.jpg";

type MenuCategory = "sushi" | "desserts" | "drinks" | "dishes";

interface MenuItem {
  name: string;
  category: MenuCategory;
  image: ImageMetadata;
  price: number;
  originalPrice?: number;
}

const menuItems: MenuItem[] = [
  {
    name: "Chimmi Makis",
    category: "sushi",
    image: chimmiMakis,
    price: 17500,
    originalPrice: 35000,
  },
  {
    name: "Migiri Sushi",
    category: "sushi",
    image: migiriSushi,
    price: 25000,
    originalPrice: 50000,
  },
  {
    name: "Togarashi Makis",
    category: "sushi",
    image: togarashiMakis,
    price: 15000,
    originalPrice: 30000,
  },
  {
    name: "Salmon Roll",
    category: "sushi",
    image: salmonRoll,
    price: 25000,
    originalPrice: 50000,
  },
  {
    name: "Macarons",
    category: "desserts",
    image: macarons,
    price: 16000,
    originalPrice: 20000,
  },
  {
    name: "Dorayaki",
    category: "desserts",
    image: dorayaki,
    price: 22000,
    originalPrice: 27500,
  },
  {
    name: "Tofu Pancake",
    category: "desserts",
    image: tofuPancake,
    price: 24000,
    originalPrice: 32000,
  },
  {
    name: "Honey Cookies",
    category: "desserts",
    image: honeyCookies,
    price: 14250,
    originalPrice: 15000,
  },
  { name: "Coffee", category: "drinks", image: coffee, price: 5000 },
  { name: "Matcha Tea", category: "drinks", image: matchaTea, price: 5000 },
  { name: "Amazake", category: "drinks", image: amazake, price: 5000 },
  { name: "Sake", category: "drinks", image: sake, price: 5000 },
  {
    name: "Tuna Poke Bowl",
    category: "dishes",
    image: tunaPokeBowl,
    price: 30000,
  },
  {
    name: "Sardine Stew",
    category: "dishes",
    image: sardineStew,
    price: 35000,
  },
  {
    name: "Vegetarian Ramen",
    category: "dishes",
    image: vegetarianRamen,
    price: 40000,
  },
  {
    name: "Vegetarian Soup",
    category: "dishes",
    image: vegetarianSoup,
    price: 20000,
  },
];

const filters = [
  { key: "all", label: "All" },
  { key: "promotions", label: "Promotions" },
  { key: "sushi", label: "Sushi" },
  { key: "dishes", label: "Dishes" },
  { key: "drinks", label: "Drinks" },
  { key: "desserts", label: "Desserts" },
];

const items = menuItems.map((item) => ({
  ...item,
  discount: item.originalPrice
    ? Math.round((1 - item.price / item.originalPrice) * 100)
    : 0,
}));

const formatMMK = (value: number) => `${value.toLocaleString("en-US")} MMK`;
---

<section id="menu" class="bg-cream" data-reveal>
  <div class="mx-auto max-w-7xl px-6 py-20 lg:px-10">
    <div id="menu-filters" class="flex flex-wrap justify-center gap-3">
      {
        filters.map((filter, index) => (
          <button
            type="button"
            data-filter={filter.key}
            aria-pressed={index === 0}
            class:list={[
              "rounded-full border px-6 py-2.5 text-sm font-semibold uppercase tracking-wide transition-colors",
              index === 0
                ? "border-primary bg-primary text-white hover:bg-primary-dark"
                : "border-ink/15 text-ink hover:border-primary hover:text-primary",
            ]}
          >
            {filter.label}
          </button>
        ))
      }
    </div>

    <div
      id="menu-grid"
      class="mt-12 grid grid-cols-2 gap-x-5 gap-y-10 sm:grid-cols-3 lg:grid-cols-4"
    >
      {
        items.map((item) => (
          <article
            data-category={item.category}
            data-promo={item.discount > 0 ? "true" : "false"}
            class="menu-card"
          >
            <div class="relative aspect-square overflow-hidden rounded-2xl">
              <Image
                src={item.image}
                alt={item.name}
                width={500}
                height={500}
                class="h-full w-full object-cover"
              />
              {item.discount > 0 && (
                <span class="absolute left-3 top-3 rounded-full bg-primary px-2.5 py-1 text-xs font-semibold text-white">
                  {item.discount}%
                </span>
              )}
            </div>
            <h3 class="font-display mt-4 text-base font-medium text-ink">
              {item.name}
            </h3>
            <p class="mt-1 flex items-baseline gap-2">
              <span class="text-sm font-semibold text-primary">
                {formatMMK(item.price)}
              </span>
              {item.discount > 0 && (
                <span class="text-xs text-muted line-through">
                  {formatMMK(item.originalPrice!)}
                </span>
              )}
            </p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<script>
  const filterBar = document.getElementById("menu-filters");
  const cards = Array.from(
    document.querySelectorAll<HTMLElement>("#menu-grid .menu-card"),
  );

  const applyFilter = (filter: string, activeButton?: HTMLButtonElement) => {
    const button =
      activeButton ??
      filterBar?.querySelector<HTMLButtonElement>(
        `button[data-filter="${filter}"]`,
      );
    if (!filterBar || !button) return;

    const activeClasses = [
      "border-primary",
      "bg-primary",
      "text-white",
      "hover:bg-primary-dark",
    ];
    const inactiveClasses = [
      "border-ink/15",
      "text-ink",
      "hover:border-primary",
      "hover:text-primary",
    ];

    filterBar
      .querySelectorAll<HTMLButtonElement>("button[data-filter]")
      .forEach((btn) => {
        const active = btn === button;
        btn.setAttribute("aria-pressed", String(active));
        activeClasses.forEach((cls) => btn.classList.toggle(cls, active));
        inactiveClasses.forEach((cls) => btn.classList.toggle(cls, !active));
      });

    cards.forEach((card) => {
      const matches =
        filter === "all" ||
        (filter === "promotions"
          ? card.dataset.promo === "true"
          : card.dataset.category === filter);
      card.classList.toggle("hidden", !matches);
    });
  };

  filterBar?.addEventListener("click", (event) => {
    const button = (event.target as HTMLElement).closest<HTMLButtonElement>(
      "button[data-filter]",
    );
    if (!button?.dataset.filter) return;

    applyFilter(button.dataset.filter, button);

    const url = new URL(window.location.href);
    if (button.dataset.filter === "all") {
      url.searchParams.delete("filter");
    } else {
      url.searchParams.set("filter", button.dataset.filter);
    }
    window.history.replaceState(null, "", url);
  });

  const requestedFilter = new URLSearchParams(window.location.search).get(
    "filter",
  );
  if (
    requestedFilter &&
    filterBar?.querySelector(`button[data-filter="${requestedFilter}"]`)
  ) {
    applyFilter(requestedFilter);
  }
</script>
