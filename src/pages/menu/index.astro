---
import Layout from "../../layouts/Layout.astro";
import PageHero from "../../components/PageHero.astro";
import Testimonials from "../../components/Testimonials.astro";
import MenuGrid from "./_sections/MenuGrid.astro";
import heroImg from "../../assets/home-img/heroImg.png";
---

<Layout
  title="Menu - Myanshi"
  description="Browse the full MYANSHI menu — sushi, dishes, drinks, and desserts, with current promotions across every branch."
>
  <main id="main-content">
    <PageHero title="Our Menu" crumbs={[{ label: "Menu" }]} image={heroImg} />
    <MenuGrid />
    <Testimonials />
  </main>
</Layout>
