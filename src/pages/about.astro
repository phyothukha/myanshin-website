---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/PageHero.astro";
import AboutUs from "../components/AboutUs.astro";
import TiktokGallery from "../components/TiktokGallery.astro";
import VisitRestaurants from "../components/VisitRestaurants.astro";
import Highlights from "../components/about/sections/Highlights.astro";
import Journey from "../components/about/sections/Journey.astro";
import Team from "../components/about/sections/Team.astro";
import aboutHeroImg from "../assets/about-page/aboutHeroImg.jpg";
---

<Layout
  title="About Us - Myanshi"
  description="Learn the story behind MYANSHI, meet our team, and find a branch near you across Yangon and Mandalay."
>
  <main>
    <PageHero title="We are MYANSHI" crumb="About Us" image={aboutHeroImg} />
    <Highlights />
    <AboutUs cta={false} />
    <Journey />
    <Team />
    <VisitRestaurants />
    <TiktokGallery />
  </main>
</Layout>
