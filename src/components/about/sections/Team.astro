---
import { Image } from "astro:assets";
import johnCarter from "../../../assets/about-page/johnCarter.png";
import sophieMoore from "../../../assets/about-page/sophieMoore.png";
import emily from "../../../assets/about-page/Emily.png";

const team = [
  { name: "John Carter", role: "Sous Chef", image: johnCarter, featured: false },
  { name: "Sophie Moore", role: "Head Chef", image: sophieMoore, featured: true },
  { name: "Emily Werber", role: "General Manager", image: emily, featured: false },
];
---

<section id="team" class="bg-cream">
  <div class="mx-auto max-w-7xl px-6 py-24 text-center lg:px-10">
    <div class="mx-auto flex w-fit items-center gap-3 text-primary">
      <span class="h-px w-10 bg-primary"></span>
      <span class="text-sm font-medium tracking-[0.2em]">チーム</span>
      <span class="h-px w-10 bg-primary"></span>
    </div>
    <h2 class="font-display mt-4 text-4xl font-medium text-ink lg:text-5xl">
      Our Amazing Team
    </h2>
    <p class="mx-auto mt-4 max-w-xl text-sm leading-relaxed text-muted">
      Our team at MYANSHI blends skill and passion to craft unforgettable
      dining experiences.
    </p>

    <div class="mt-14 grid gap-8 sm:grid-cols-3 sm:items-end">
      {
        team.map((member) => (
          <div>
            <div class="overflow-hidden rounded-3xl">
              <Image
                src={member.image}
                alt={member.name}
                width={400}
                height={member.featured ? 520 : 460}
                class:list={[
                  "w-full object-cover",
                  member.featured ? "h-96" : "h-80",
                ]}
              />
            </div>
            <h3 class="font-display mt-5 text-lg font-medium text-ink">
              {member.name}
            </h3>
            <p
              class:list={[
                "mt-1 text-xs font-semibold uppercase tracking-wide",
                member.featured ? "text-primary" : "text-muted",
              ]}
            >
              {member.role}
            </p>
          </div>
        ))
      }
    </div>
  </div>
</section>
