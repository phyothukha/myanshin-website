---
import { Icon } from "astro-icon/components";

const items = [
  {
    title: "Authentic Taste",
    description:
      "Delivering the original flavors of Japan through traditional recipes and fresh ingredients.",
    icon: "ph:seal-check-duotone",
  },
  {
    title: "Multi Cuisine",
    description:
      "Explore a fusion of authentic Japanese flavors, crafted with care to suit every palate.",
    icon: "ph:cooking-pot-duotone",
  },
  {
    title: "Affordable Dining",
    description:
      "Offering a premium dining experience at prices that suit every budget.",
    icon: "ph:hand-coins-duotone",
  },
];
---

<section class="bg-cream">
  <div
    class="mx-auto grid max-w-7xl gap-10 px-6 py-20 sm:grid-cols-3 sm:gap-6 lg:px-10"
  >
    {
      items.map((item) => (
        <div class="flex items-start gap-4">
          <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-primary/10 text-primary">
            <Icon name={item.icon} class="h-6 w-6" />
          </span>
          <div>
            <h3 class="font-display text-lg font-medium text-ink">
              {item.title}
            </h3>
            <p class="mt-1.5 text-sm leading-relaxed text-muted">
              {item.description}
            </p>
          </div>
        </div>
      ))
    }
  </div>
</section>
