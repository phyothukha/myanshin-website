---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import heroImg from "../assets/Home/heroImg.png";
import platterImg from "../assets/Home/adsImg.png";
---

<section class="relative bg-ink">
  <Image
    src={heroImg}
    alt=""
    role="presentation"
    width={2880}
    height={2000}
    class="absolute inset-0 h-full w-full object-cover opacity-70"
  />
  <div
    class="absolute inset-0 bg-linear-to-t from-ink via-ink/70 to-ink/40"
  >
  </div>

  <div
    class="relative mx-auto flex max-w-7xl flex-col px-6 pb-32 pt-20 lg:px-10 lg:pb-40 lg:pt-28"
  >
    <div class="flex items-center gap-3 text-primary">
      <span class="h-px w-10 bg-primary"></span>
      <span class="text-sm font-medium tracking-[0.2em]">ミャンマーへようこそ</span>
    </div>

    <h1
      class="font-display mt-6 max-w-2xl text-5xl font-medium leading-[1.1] text-white sm:text-6xl lg:text-7xl"
    >
      Fresh, Flavorful Sushi, Only in Myanmar
    </h1>

    <p class="mt-6 max-w-md text-base leading-relaxed text-white/70">
      Discover the artistry of sushi at its finest. From fresh ingredients to
      time-honored techniques, every dish is crafted to delight your senses.
    </p>

    <div class="mt-9 flex flex-wrap items-center gap-4">
      <a
        href="#contact"
        class="rounded-full bg-primary px-7 py-3.5 text-sm font-semibold text-white transition-colors hover:bg-primary-dark"
      >
        Book a Table
      </a>
      <a
        href="#menu"
        class="rounded-full border border-white/30 px-7 py-3.5 text-sm font-semibold text-white transition-colors hover:border-white hover:bg-white/10"
      >
        Our Menu
      </a>
    </div>
  </div>

  <div
    class="absolute -bottom-16 left-6 z-20 hidden w-64 overflow-hidden rounded-2xl shadow-2xl ring-1 ring-white/10 sm:block lg:left-10 lg:w-80"
  >
    <Image
      src={platterImg}
      alt="Fresh sushi platter with lemon and ginger"
      width={640}
      height={420}
      class="h-full w-full object-cover"
    />
  </div>

  <a
    href="#menu"
    aria-label="Scroll to menu"
    class="absolute bottom-6 left-1/2 hidden h-12 w-12 -translate-x-1/2 items-center justify-center rounded-full border border-white/30 text-white transition-colors hover:border-primary hover:text-primary sm:flex"
  >
    <Icon name="ph:arrow-down" class="h-5 w-5" />
  </a>
</section>
