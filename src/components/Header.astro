---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import logo from "../assets/Home/myanshi_logo.png";

const navLinks = [
  { label: "Home", href: "/" },
  { label: "About", href: "#about" },
  { label: "Menu", href: "#menu" },
  { label: "Contact", href: "#contact" },
  { label: "Blog", href: "#articles" },
  { label: "Our Team", href: "#about" },
];
---

<header class="sticky top-0 z-50 bg-ink/95 backdrop-blur">
  <div
    class="mx-auto flex max-w-7xl items-center justify-between gap-6 px-6 py-4 lg:px-10"
  >
    <a href="/" class="flex items-center gap-2">
      <Image src={logo} alt="Myanshi" width={40} height={40} class="h-9 w-9" />
      <span class="font-display text-xl font-semibold tracking-wide text-white"
        >MYANSHI</span
      >
    </a>

    <nav class="hidden items-center gap-8 lg:flex">
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            class="text-sm font-medium uppercase tracking-wide text-white/80 transition-colors hover:text-primary"
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-3">
      <a
        href="tel:+959123456789"
        class="hidden items-center gap-2 rounded-full bg-primary px-5 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-primary-dark sm:flex"
      >
        <Icon name="ph:phone-fill" class="h-4 w-4" />
        Call Now
      </a>

      <button
        id="menu-toggle"
        type="button"
        aria-label="Toggle menu"
        aria-expanded="false"
        class="flex h-10 w-10 items-center justify-center rounded-full text-white lg:hidden"
      >
        <Icon name="ph:list" class="h-6 w-6" />
      </button>
    </div>
  </div>

  <nav
    id="mobile-menu"
    class="hidden flex-col gap-1 border-t border-white/10 px-6 pb-4 lg:hidden"
  >
    {
      navLinks.map((link) => (
        <a
          href={link.href}
          class="rounded-lg px-3 py-2.5 text-sm font-medium uppercase tracking-wide text-white/80 transition-colors hover:bg-white/5 hover:text-primary"
        >
          {link.label}
        </a>
      ))
    }
  </nav>
</header>

<script>
  const toggle = document.getElementById("menu-toggle");
  const menu = document.getElementById("mobile-menu");

  toggle?.addEventListener("click", () => {
    const isOpen = menu?.classList.toggle("flex");
    menu?.classList.toggle("hidden");
    toggle.setAttribute("aria-expanded", String(Boolean(isOpen)));
  });
</script>
