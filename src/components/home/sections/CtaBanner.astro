---
import { Image } from "astro:assets";
import bannerImg from "../../../assets/home-img/adsImg.png";
---

<section class="relative isolate overflow-hidden bg-ink">
  <Image
    src={bannerImg}
    alt=""
    role="presentation"
    width={2028}
    height={1333}
    class="absolute inset-0 h-full w-full object-cover opacity-50"
  />
  <div class="absolute inset-0 bg-ink/70"></div>

  <div
    class="relative mx-auto flex max-w-7xl flex-col items-start gap-8 px-6 py-24 lg:flex-row lg:items-center lg:justify-between lg:px-10"
  >
    <h2 class="font-display max-w-xl text-3xl font-medium text-white sm:text-4xl lg:text-5xl">
      Taste the most delicious sushi in Myanmar
    </h2>

    <div class="flex flex-shrink-0 flex-wrap items-center gap-4">
      <a
        href="https://www.tiktok.com"
        target="_blank"
        rel="noopener noreferrer"
        class="rounded-full bg-primary px-7 py-3.5 text-sm font-semibold text-white transition-colors hover:bg-primary-dark"
      >
        Follow Us
      </a>
      <a
        href="#menu"
        class="rounded-full border border-white/30 px-7 py-3.5 text-sm font-semibold text-white transition-colors hover:border-white hover:bg-white/10"
      >
        Our Menu
      </a>
    </div>
  </div>
</section>
