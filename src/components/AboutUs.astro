---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import journeyLarge from "../assets/AboutUs/Myanshi Journey 1.jpg";
import journeySmall from "../assets/AboutUs/Myanshi Journey 2.jpg";

const highlights = [
  "Experience the rich traditions of Japanese culinary art",
  "Sourced daily for the finest quality and taste",
  "Dine in comfort with our warm and inviting setup",
];
---

<section id="about" class="bg-cream">
  <div
    class="mx-auto grid max-w-7xl gap-16 px-6 py-24 lg:grid-cols-2 lg:items-center lg:gap-20 lg:px-10"
  >
    <div class="relative mx-auto max-w-md lg:mx-0">
      <div class="overflow-hidden rounded-3xl">
        <Image
          src={journeyLarge}
          alt="Myanshi sushi and sashimi platter"
          width={640}
          height={700}
          class="h-[26rem] w-full object-cover sm:h-[30rem]"
        />
      </div>

      <div
        class="absolute -bottom-10 -right-6 w-40 overflow-hidden rounded-2xl shadow-xl ring-4 ring-cream sm:w-48"
      >
        <Image
          src={journeySmall}
          alt="Fresh sushi roll close-up"
          width={320}
          height={420}
          class="h-48 w-full object-cover sm:h-56"
        />
      </div>

      <div
        class="absolute -left-6 top-6 flex flex-col items-center justify-center rounded-2xl bg-primary px-5 py-4 text-white shadow-lg"
      >
        <span class="font-display text-2xl font-semibold">2019</span>
        <span class="text-xs uppercase tracking-wide">Founded</span>
      </div>

      <div
        class="absolute -right-4 top-1/3 flex flex-col items-center justify-center rounded-2xl bg-white px-5 py-4 text-ink shadow-lg"
      >
        <span class="font-display text-2xl font-semibold">64+</span>
        <span class="text-xs uppercase tracking-wide text-muted">Team members</span>
      </div>
    </div>

    <div class="lg:pl-8">
      <div class="flex items-center gap-3 text-primary">
        <span class="h-px w-10 bg-primary"></span>
        <span class="text-sm font-medium tracking-[0.2em]">私たちについて</span>
      </div>
      <h2 class="font-display mt-4 text-4xl font-medium text-ink lg:text-5xl">
        About Us
      </h2>
      <p class="mt-5 max-w-lg text-base leading-relaxed text-muted">
        Founded in Yangon, Myanmar in 2019, MYANSHI has been dedicated to
        providing exceptional products and services. With a passion for
        quality and customer satisfaction, we continue to grow and create
        memorable experiences for everyone who dines with us.
      </p>

      <ul class="mt-8 space-y-4">
        {
          highlights.map((point) => (
            <li class="flex items-start gap-3">
              <Icon
                name="ph:check-circle-fill"
                class="mt-0.5 h-5 w-5 shrink-0 text-primary"
              />
              <span class="text-sm text-ink/80">{point}</span>
            </li>
          ))
        }
      </ul>

      <a
        href="#about"
        class="mt-9 inline-flex items-center gap-2 rounded-full bg-primary px-7 py-3.5 text-sm font-semibold text-white transition-colors hover:bg-primary-dark"
      >
        See More
      </a>
    </div>
  </div>
</section>
